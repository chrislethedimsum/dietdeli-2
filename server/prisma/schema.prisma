generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  password          String
  phone             String
  dob               DateTime?
  address           String?
  gender            String?
  height            Int?
  weight            Int?
  goal              String?
  activityLevel     String?            @map("activity_level")
  isAdmin           Boolean            @default(false)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  orders            Order[]
  userSubscriptions UserSubscription[]
  refreshToken      String?            @map("refresh_token")

  @@map("user")
}

model MealPackage {
  id                Int                @id @default(autoincrement())
  name              String
  caloriesPerMeal   Int                @map("calories_per_meal")
  durationDays      Int                @map("duration_days")
  price             Int
  totalMeals        Int                @map("total_meals")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  orders            Order[]
  userSubscriptions UserSubscription[]

  @@map("meal_package")
}

model Dish {
  id            Int         @id @default(autoincrement())
  nameVi        String      @map("name_vi")
  nameEn        String      @map("name_en")
  descriptionVi String?     @map("description_vi")
  descriptionEn String?     @map("description_en")
  image         String?
  isDeleted     Boolean     @default(false)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  menus         Menu[]
  orderItems    OrderItem[]

  @@map("dish")
}

model Menu {
  id        Int      @id @default(autoincrement())
  dishId    Int      @map("dish_id")
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@map("menu")
}

enum paymentStatus {
  UNPAID
  PAID
  PROCESSING
  CANCELLED
  COMPLETED
  EXPIRED
}

model UserSubscription {
  id                  Int           @id @default(autoincrement())
  idUser              Int           @map("id_user")
  packageId           Int           @map("package_id")
  startDate           DateTime      @map("start_date")
  endDate             DateTime      @map("end_date")
  paymentStatus       paymentStatus @default(UNPAID) @map("payment_status")
  remainingMeals      Int           @map("remaining_meals")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  orders              Order[]     
  user                User          @relation(fields: [idUser], references: [id], onDelete: Cascade)
  package             MealPackage   @relation(fields: [packageId], references: [id])
  userNote            String?       @map("user_note")
  adminNote           String?       @map("admin_note")
  planShippingAddress String?       @map("plan_shipping_address")
  planPhone           String?       @map("plan_phone")

  @@map("user_subscription")
}

enum MealShift {
  LUNCH   // Bữa trưa
  DINNER  // Bữa tối
}
enum OrderStatus {
  ORDERED    // Đã đặt món
  COOKING    // Đang chuẩn bị
  SHIPPING   // Đang giao
  COMPLETED  // Đã giao thành công
  CANCELLED  // Đã hủy món (hoàn suất ăn)
}
model Order {
  id                 Int              @id @default(autoincrement())
  userSubscriptionId Int              @map("user_subscription_id")
  userId             Int              @map("user_id")
  packageId          Int              @map("package_id")

  deliveryDate       DateTime         @map("delivery_date") // Ngày nhận món
  mealShift          MealShift        @default(LUNCH) @map("meal_shift")
  
  shippingAddress    String           @map("shipping_address")
  shippingNote       String?          @map("shipping_note")
  status             OrderStatus      @default(ORDERED)
  
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  
  package            MealPackage      @relation(fields: [packageId], references: [id])
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSubscription   UserSubscription @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  @@map("order")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  dishId    Int      @map("dish_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  dish      Dish     @relation(fields: [dishId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_item")
}
